-- Copia local del inventario. Es la unica fuente de verdad de la pantalla:
-- la red solo la mantiene al dia (sesion 11, offline-first).
CREATE TABLE producto (
    id        INTEGER NOT NULL PRIMARY KEY,
    nombre    TEXT    NOT NULL,
    precio    REAL    NOT NULL,
    stock     INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1;

buscarPorId:
SELECT * FROM producto WHERE id = ?;

insertar:
INSERT OR REPLACE INTO producto
VALUES (?, ?, ?, ?, ?);

borrarPorId:
DELETE FROM producto WHERE id = ?;

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
-- COALESCE evita el NULL de la tabla vacia; el minOf de Kotlin
-- garantiza que el id resultante sea siempre negativo.
SELECT COALESCE(MIN(id), 0) FROM producto;
