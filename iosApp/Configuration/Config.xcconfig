TEAM_ID=

PRODUCT_NAME=PharmaMobil
PRODUCT_BUNDLE_IDENTIFIER=pe.edu.upeu.pharmamobil.PharmaMobil$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
